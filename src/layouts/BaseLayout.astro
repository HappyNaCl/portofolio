---
import { site as contact } from '../data/site';
import '../styles/fonts.css';
import '../styles/broadsheet.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yudhistira',
  url: site.href,
  image: ogImage.href,
  email: `mailto:${contact.email}`,
  jobTitle: 'DevOps Engineer',
  description,
  worksFor: { '@type': 'Organization', name: 'BINUS University' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'BINUS University' },
  knowsAbout: [
    'Kubernetes',
    'Docker',
    'CI/CD',
    'Observability',
    'Go',
    'TypeScript',
  ],
  sameAs: [contact.github, contact.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yudhistira" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Yudhistira — DevOps engineer and full-stack developer. Open to work, remote or Jakarta."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(person)}
    />

    <script is:inline>
      // Runs before first paint. The `js` class is what lets the reveal
      // animation start from a hidden state without a no-JS visitor being
      // left with a blank page.
      document.documentElement.classList.add('js');

      (function () {
        try {
          var stored = localStorage.getItem('yd-theme');
          var dark = stored
            ? stored === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
