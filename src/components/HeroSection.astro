---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

// The ids are matched by the show/hide selectors in the stylesheet below; keep
// the two in step if a track is added or renamed.
const tracks = [
  {
    id: 'devops',
    label: 'DevOps',
    icon: 'ph:hard-drives-bold',
    lines: ['DevOps', 'engineer'],
    intro:
      'I keep Kubernetes clusters, app deployments, and network infrastructure \
       running. Certified to teach Docker and Kubernetes before this, which is \
       how I learned them properly instead of memorizing commands.',
  },
  {
    id: 'fullstack',
    label: 'Full-stack',
    icon: 'ph:code-bold',
    lines: ['Full-stack', 'developer'],
    intro:
      'I build the internal tools our network administrators use day to day: \
       the schema, the API over it, and the interface people actually touch. \
       I own it end to end, which means I also get to hear exactly what is broken about it.',
  },
];
---

<section id="top" class="section hero">
  <!-- Plain radios, styled as a segmented control. The swap below is pure CSS
       (:has), so it works without JavaScript and keeps native arrow-key
       behaviour for free. -->
  <fieldset class="switch" data-reveal>
    <legend class="visually-hidden">Show my work as</legend>
    {
      tracks.map((track, i) => (
        <label class="switch-option">
          <input
            type="radio"
            name="track"
            value={track.id}
            checked={i === 0}
            class="visually-hidden"
          />
          <Icon name={track.icon} aria-hidden="true" />
          {track.label}
        </label>
      ))
    }
  </fieldset>

  <h1 class="headline">
    {
      tracks.map((track) => (
        <span class="role" data-track={track.id}>
          <Fragment set:html={track.lines.join('<br>')} /><span class="accent"
            >.</span
          >
        </span>
      ))
    }
  </h1>

  <div class="intro" data-reveal>
    {
      tracks.map((track) => (
        <p class="intro-copy" data-track={track.id}>
          I'm <strong class="intro-name">Yudhistira</strong>. {track.intro}
        </p>
      ))
    }
  </div>

  <div class="actions" data-reveal>
    <a href="#cv" class="btn-nb btn-nb--ink btn-nb--lift">
      <Icon name="ph:arrow-down-bold" aria-hidden="true" />
      View résumé
    </a>
    <a
      href={site.github}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label="GitHub"
      title="GitHub"
    >
      <Icon name="ph:github-logo-bold" aria-hidden="true" />
    </a>
    <a
      href={site.linkedin}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <Icon name="ph:linkedin-logo-bold" aria-hidden="true" />
    </a>
    <a
      href={`mailto:${site.email}`}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label={`Email ${site.email}`}
      title={site.email}
    >
      <Icon name="ph:envelope-simple-bold" aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 84px);
    padding-bottom: 70px;
  }

  .headline {
    display: grid;
    font-size: clamp(44px, 8.5vw, 110px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 28px 0 0;
    max-width: 15ch;
  }

  .accent {
    color: var(--cyan);
  }

  .intro {
    display: grid;
    font-size: clamp(18px, 2.1vw, 24px);
    line-height: 1.5;
    max-width: 58ch;
    margin: 24px 0 0;
    color: var(--ink-2);
  }

  .intro-copy {
    margin: 0;
    text-wrap: pretty;
  }

  .intro-name {
    color: var(--ink);
  }

  /* Both tracks share one grid cell, so the block is sized by the taller of
     them and nothing below jumps on switch. The outgoing copy fades first and
     the incoming one waits for it, so the two never overlap mid-fade. */
  .role,
  .intro-copy {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s ease 0.18s,
      transform 0.3s ease 0.18s,
      visibility 0s linear 0.18s;
  }

  /* DevOps is the default, so a browser without :has still shows a full
     headline rather than none. */
  [data-track='fullstack'],
  .hero:has(input[value='fullstack']:checked) [data-track='devops'] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0s linear 0.18s;
  }

  .hero:has(input[value='fullstack']:checked) [data-track='fullstack'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s ease 0.18s,
      transform 0.3s ease 0.18s,
      visibility 0s linear 0.18s;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 459px) {
    .actions > :first-child {
      flex: 1 1 100%;
    }
  }
</style>
