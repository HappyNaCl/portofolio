---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const roles = [
  {
    lines: ['DevOps', 'engineer'],
    intro:
      'I keep Kubernetes clusters, app deployments, and network infrastructure \
       running. Certified to teach Docker and Kubernetes before this, which is \
       how I learned them properly instead of memorizing commands.',
  },
  {
    lines: ['Full-stack', 'developer'],
    intro:
      'I build the internal tools our network administrators use day to day: \
       the schema, the API over it, and the interface people actually touch. \
       I own it end to end, which means I also get to hear exactly what is broken about it.',
  },
];

const [firstRole] = roles;
---

<section id="top" class="section hero">
  <div class="badge" data-reveal>
    <span class="badge-dot" aria-hidden="true"></span>
    Open to work — remote / Jakarta
  </div>

  <h1 class="headline">
    <span
      class="role"
      data-role-word
      data-roles={JSON.stringify(roles.map((role) => role.lines))}
    >
      <span data-role-text set:html={firstRole.lines.join('<br>')}></span><span
        class="accent">.</span
      >
    </span>
  </h1>

  <button type="button" class="role-toggle" data-role-toggle>
    <Icon
      name="ph:pause-bold"
      class="role-toggle-icon role-toggle-icon--pause"
      aria-hidden="true"
    />
    <Icon
      name="ph:play-bold"
      class="role-toggle-icon role-toggle-icon--play"
      aria-hidden="true"
    />
    <span data-role-toggle-label>Pause</span>
  </button>

  <div class="intro" data-reveal>
    {
      roles.map((role, i) => (
        <p
          class:list={['intro-copy', { 'is-current': i === 0 }]}
          data-role-intro
        >
          {role.intro}
        </p>
      ))
    }
  </div>

  <div class="actions" data-reveal>
    <a href="#cv" class="btn-nb btn-nb--ink btn-nb--lift">
      <Icon name="ph:arrow-down-bold" aria-hidden="true" />
      View résumé
    </a>
    <a
      href={site.github}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label="GitHub"
      title="GitHub"
    >
      <Icon name="ph:github-logo-bold" aria-hidden="true" />
    </a>
    <a
      href={site.linkedin}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <Icon name="ph:linkedin-logo-bold" aria-hidden="true" />
    </a>
    <a
      href={`mailto:${site.email}`}
      class="btn-nb btn-nb--tint btn-nb--icon"
      aria-label={`Email ${site.email}`}
      title={site.email}
    >
      <Icon name="ph:envelope-simple-bold" aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 110px);
    padding-bottom: 70px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 3px solid var(--ink);
    background: var(--magenta-tint);
    padding: 6px 14px;
    box-shadow: 5px 5px 0 var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 9px;
    height: 9px;
    background: var(--magenta);
    border-radius: 50%;
  }

  .headline {
    font-size: clamp(44px, 8.5vw, 110px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 28px 0 0;
    max-width: 15ch;
    min-height: 1.9em;
    display: flex;
    align-items: flex-start;
  }

  .role {
    display: inline-block;
    transition:
      opacity 0.34s ease,
      transform 0.34s ease;
  }

  .role.is-out {
    opacity: 0;
    transform: translateY(16px);
  }

  .accent {
    color: var(--cyan);
  }

  .intro {
    display: grid;
    font-size: clamp(18px, 2.1vw, 24px);
    line-height: 1.5;
    max-width: 58ch;
    margin: 24px 0 0;
    color: var(--ink-2);
  }

  .intro-copy {
    grid-area: 1 / 1;
    margin: 0;
    text-wrap: pretty;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.34s ease,
      visibility 0s linear 0.34s;
  }

  .intro-copy.is-current {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.34s ease,
      visibility 0s;
  }

  /* Revealed by script: without JS the headline never rotates, so a pause
     control would do nothing. */
  .role-toggle {
    display: none;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    padding: 5px 12px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: transparent;
    border: 2px solid var(--ink-3);
    border-radius: 999px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .role-toggle.is-live {
    display: inline-flex;
  }

  .role-toggle:hover {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--cyan-tint);
  }

  .role-toggle-icon {
    width: 11px;
    height: 11px;
    flex: none;
  }

  .role-toggle-icon--play,
  .role-toggle.is-paused .role-toggle-icon--pause {
    display: none;
  }

  .role-toggle.is-paused .role-toggle-icon--play {
    display: block;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 459px) {
    .actions > :first-child {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  const word = document.querySelector<HTMLElement>('[data-role-word]');
  const text = word?.querySelector<HTMLElement>('[data-role-text]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-role-toggle]');
  const toggleLabel = toggle?.querySelector<HTMLElement>(
    '[data-role-toggle-label]'
  );
  const intros = Array.from(
    document.querySelectorAll<HTMLElement>('[data-role-intro]')
  );

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (word && text && !reducedMotion) {
    let roles: string[][] = [];
    try {
      roles = JSON.parse(word.dataset.roles ?? '[]');
    } catch {
      roles = [];
    }

    if (roles.length > 1) {
      const FADE_MS = 340;
      const HOLD_MS = 8000;
      let index = 0;
      let timer = 0;

      const paint = (lines: string[]) => {
        text.replaceChildren(
          ...lines.flatMap<Node | string>((line, i) =>
            i === 0 ? [line] : [document.createElement('br'), line]
          )
        );
      };

      const advance = () => {
        word.classList.add('is-out');
        intros[index]?.classList.remove('is-current');

        setTimeout(() => {
          index = (index + 1) % roles.length;
          paint(roles[index]);
          word.classList.remove('is-out');
          intros[index]?.classList.add('is-current');
        }, FADE_MS);
      };

      const queue = () => {
        timer = window.setTimeout(() => {
          if (!document.hidden) advance();
          queue();
        }, HOLD_MS);
      };

      const start = () => {
        if (!timer) queue();
      };

      const stop = () => {
        window.clearTimeout(timer);
        timer = 0;
      };

      start();

      // WCAG 2.2.2: content that updates itself for longer than five seconds
      // needs a way to stop it.
      if (toggle && toggleLabel) {
        toggle.classList.add('is-live');

        toggle.addEventListener('click', () => {
          const wasRunning = Boolean(timer);
          if (wasRunning) stop();
          else start();

          // The label carries the state, so no aria-pressed on top of it.
          toggle.classList.toggle('is-paused', wasRunning);
          toggleLabel.textContent = wasRunning ? 'Play' : 'Pause';
        });
      }
    }
  }
</script>
