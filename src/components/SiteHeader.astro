---
const nav = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#cv', label: 'CV' },
];
---

<header class="header" data-site-header>
  <div class="brand">Yudhistira<span class="dot">.</span></div>

  <nav class="nav-links" aria-label="Primary">
    {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>

  <a href="#contact" class="btn-nb btn-nb--cyan cta">Get in touch</a>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px var(--gutter);
    background: var(--paper);
    border-bottom: 3px solid var(--ink);
  }

  .brand {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .dot {
    color: var(--magenta);
  }

  .nav-links {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 600;
    padding: 6px 12px;
    border: 2px solid transparent;
    color: var(--ink);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .nav-links a:hover {
    border-color: var(--ink);
    background: var(--cyan-tint);
    color: var(--ink);
  }

  .cta {
    --nb-size: 4px;
    font-size: 14px;
    padding: 8px 16px;
  }

  @media (max-width: 520px) {
    .header {
      flex-wrap: wrap;
      gap: 10px;
    }

    .nav-links {
      order: 3;
      width: 100%;
      margin-left: -12px;
    }
  }
</style>

<script>
  // The header is sticky and wraps to a second row under 520px, so its height
  // is not a constant. Feed the real value to scroll-padding-top, otherwise
  // anchored sections land underneath it.
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const publish = () => {
      document.documentElement.style.setProperty(
        '--header-h',
        `${header.offsetHeight}px`
      );
    };

    publish();
    new ResizeObserver(publish).observe(header);
  }
</script>
