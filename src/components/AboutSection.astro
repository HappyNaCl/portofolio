---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const [entry] = await getCollection('about');
if (!entry) {
  throw new Error('src/content/about/: expected one markdown file, found none');
}

const { portraitCaption, portrait, portraitAlt, skills } = entry.data;
const { Content } = await render(entry);
---

<section id="about" class="section about">
  <div class="section-head" data-reveal>
    <h2>About Yudhistira</h2>
  </div>

  <div class="columns">
    <div data-reveal>
      <div class="prose">
        <Content />
      </div>

      <ul class="skills">
        {skills.map((skill) => <li class="skill">{skill}</li>)}
      </ul>
    </div>

    {
      portrait ? (
        <Image
          class="portrait portrait-img"
          src={portrait}
          alt={portraitAlt!}
          widths={[400, 700]}
          sizes="(max-width: 640px) 100vw, 40vw"
          data-reveal
        />
      ) : (
        <div class="plate portrait" data-reveal>
          <span class="plate-caption mono">{portraitCaption}</span>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    padding-top: 40px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 44px;
    margin-top: 40px;
    align-items: start;
  }

  .prose :global(p) {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 22px 0 0;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .prose :global(p:first-child) {
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
    max-width: 52ch;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .skill {
    font-family: var(--font-mono);
    font-size: 12px;
    border: 2px solid var(--ink);
    padding: 5px 10px;
    background: var(--surface);
  }

  .portrait {
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    aspect-ratio: 4 / 5;
  }

  .portrait-img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
