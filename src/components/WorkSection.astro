---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const MAX_PROJECTS = 4;
const FULL_WIDTH = 1920;

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const seenOrder = new Map<number, string>();
for (const entry of entries) {
  const clash = seenOrder.get(entry.data.order);
  if (clash) {
    throw new Error(
      `src/content/projects: order ${entry.data.order} is used by both ` +
        `${clash}.md and ${entry.id}.md. Every project needs a unique order.`
    );
  }
  seenOrder.set(entry.data.order, entry.id);
}

const projects = await Promise.all(
  entries.slice(0, MAX_PROJECTS).map(async (entry) => ({
    ...entry.data,
    num: String(entry.data.order).padStart(2, '0'),
    full: entry.data.cover
      ? (
          await getImage({
            src: entry.data.cover,
            width: Math.min(FULL_WIDTH, entry.data.cover.width),
          })
        ).src
      : null,
    Content: (await render(entry)).Content,
  }))
);

const count = String(projects.length).padStart(2, '0');
---

<section id="work" class="section work">
  <div class="section-head" data-reveal>
    <h2>Selected work</h2>
    <span class="mono count">{count} projects</span>
  </div>

  <div class="grid">
    {
      projects.map(({ Content, ...project }) => (
        <article class="project" data-reveal>
          <div class="project-inner">
            {
              project.cover ? (
                <button
                  type="button"
                  class="shot shot-btn"
                  data-lightbox
                  data-full={project.full}
                  data-alt={project.coverAlt!}
                  aria-label={`Open the ${project.title} cover full size`}
                >
                  <Image
                    class="shot-img"
                    src={project.cover}
                    alt={project.coverAlt!}
                    widths={[400, 700, 1000]}
                    sizes="(max-width: 640px) 100vw, 50vw"
                    loading="lazy"
                  />
                </button>
              ) : (
                <div class="plate shot">
                  <span class="plate-caption mono">{project.shot}</span>
                </div>
              )
            }

            <div class="body">
              <div class="meta mono">
                <span>{project.num}</span>
                <span class="meta-sub">
                  {project.year} — {project.role}
                </span>
              </div>

              <h3 class="title">{project.title}</h3>

              <div class="blurb">
                <Content />
              </div>

              <ul class="stack">
                {project.stack.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>

              {project.repo && (
                <a
                  href={project.repo}
                  class="btn-nb btn-nb--tint btn-nb--lift repo"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.title} source on GitHub`}
                >
                  <Icon name="ph:github-logo-bold" aria-hidden="true" />
                  Repo
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Project cover">
    <button
      type="button"
      class="lightbox-close"
      data-lightbox-close
      aria-label="Close image"
    >
      <Icon name="ph:x-bold" size={22} aria-hidden="true" />
    </button>
    <img class="lightbox-img" data-lightbox-img alt="" />
  </dialog>
</section>

<style>
  .work {
    padding-top: 40px;
  }

  .count {
    color: var(--ink-3);
    padding-bottom: 8px;
  }

  .grid {
    display: grid;
    gap: 34px;
    margin-top: 44px;
  }

  .project {
    border: 3px solid var(--ink);
    background: var(--surface);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .project-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .shot {
    min-height: 240px;
  }

  .shot-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .shot-btn:hover .shot-img {
    opacity: 0.85;
  }

  .shot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.15s ease;
  }

  .body {
    padding: 26px 28px 28px;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    letter-spacing: 0.1em;
    color: var(--cyan-deep);
  }

  .meta-sub {
    color: var(--ink-3);
  }

  .title {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 10px 0 0;
  }

  .blurb {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 14px 0 0;
    max-width: 46ch;
    text-wrap: pretty;
  }

  .blurb :global(p) {
    margin: 0;
  }

  .blurb :global(p + p) {
    margin-top: 0.8em;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    background: var(--cyan-tint);
    padding: 4px 9px;
  }

  .repo {
    --nb-size: 5px;
    font-size: 14px;
    padding: 10px 18px;
    margin-top: 22px;
  }

  .lightbox {
    position: relative;
    padding: 0;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--surface);
    box-shadow: 10px 10px 0 var(--ink);
    max-width: min(96vw, 1700px);
    max-height: 92vh;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(32, 30, 29, 0.74);
  }

  .lightbox[open] {
    animation: lightbox-in 0.18s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .lightbox-img {
    display: block;
    max-width: min(96vw, 1700px);
    max-height: 92vh;
    width: auto;
    height: auto;
  }

  .lightbox-close {
    position: absolute;
    top: -3px;
    right: -3px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    transition: background 0.15s ease;
  }

  .lightbox-close:hover {
    background: var(--magenta-tint);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-lightbox-dialog]'
  );
  const image = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  let offset = 0;

  // `overflow: hidden` on the body propagates to the viewport, which clamps the
  // scroll offset to 0. Take the body out of flow instead and put it back where
  // it was on close.
  function lock() {
    offset = window.scrollY;
    const bar = window.innerWidth - document.documentElement.clientWidth;
    document.body.style.position = 'fixed';
    document.body.style.top = -offset + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.paddingRight = bar > 0 ? bar + 'px' : '';
  }

  function unlock() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.paddingRight = '';
    window.scrollTo({ top: offset, behavior: 'instant' });
  }

  if (dialog && image) {
    for (const trigger of document.querySelectorAll<HTMLButtonElement>(
      '[data-lightbox]'
    )) {
      trigger.addEventListener('click', () => {
        image.src = trigger.dataset.full ?? '';
        image.alt = trigger.dataset.alt ?? '';
        lock();
        dialog.showModal();
      });
    }

    dialog
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());

    // A click landing outside the dialog box still targets the dialog itself.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) dialog.close();
    });

    dialog.addEventListener('close', () => {
      unlock();
      image.removeAttribute('src');
    });
  }
</script>
